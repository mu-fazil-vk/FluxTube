<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView, not the default SurfaceView: Flutter can only composite a
     SurfaceView through a virtual display, which loses the video surface when
     the view is resized (e.g. rotating into fullscreen). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:shutter_background_color="@android:color/black" />
